# Target defaults to the parent of this directory, which is the home directory
# as long as the repo is cloned to ~/dotfiles. Stow doesn't expand $HOME, so an
# explicit --target can't be portable across machines -- rely on the default.
--ignore=.stowrc
--ignore=AGENTS.md
--ignore=README.md
--ignore=CONVENTIONS.md
--ignore=mise.toml
--ignore=docs
--ignore=dataview-queries.md
