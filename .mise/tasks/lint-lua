#!/usr/bin/env bash
#MISE description="Lint Lua with luacheck"
set -euo pipefail

echo "=== Linting Lua (luacheck) ==="
LUACHECK_BIN="$(command -v luacheck || true)"
if [ -n "$LUACHECK_BIN" ]; then
  "$LUACHECK_BIN" --config nvim/.config/nvim/.luacheckrc nvim/.config/nvim/lua/
else
  echo "WARNING: luacheck not found (brew install luacheck) — skipping Lua lint"
fi
