#!/usr/bin/env bash
#MISE description="Bootstrap all dependencies"
set -euo pipefail

echo "=== Install tools ==="
mise install
# luacheck comes from Homebrew (bottled, no compiler needed) — see homebrew/Brewfile

echo "=== Install Pi extension deps ==="
(cd pi/.pi/agent/extensions && bun install)

echo "=== Install git hooks ==="
git config core.hooksPath .githooks
