{
  "providers": {
    // apiKey is declared so pi's branch-summarization and compaction auth paths resolve a
    // real key. Those paths call getApiKeyAndHeaders() with includeFallback:false, which skips
    // pure env-var resolution (OPENCODE_API_KEY); a provider-level apiKey is returned directly.
    // Built-in opencode-go models are preserved (no `models` array = override-only entry).
    // `headers: {}` is a required validation no-op for override-only entries (resolves to undefined).
    "opencode-go": {
      "apiKey": "$OPENCODE_API_KEY",
      "headers": {}
    },
    "zai": {
      "apiKey": "$ZAI_API_KEY",
      "models": [
        {
          "id": "glm-5.2",
          "name": "GLM-5.2",
          "api": "openai-completions",
          "provider": "zai",
          "baseUrl": "https://api.z.ai/api/coding/paas/v4",
          "compat": {
            "supportsDeveloperRole": false,
            "thinkingFormat": "zai",
            "zaiToolStream": true
          },
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": "max"
          },
          "input": ["text"],
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "contextWindow": 1000000,
          "maxTokens": 131072
        },
        {
          // GLM-5.3-Flash (released 2026-08-26) — not yet in pi's built-in catalog.
          // Copied from the built-in zai glm-5.3 entry, with Flash's differences:
          // natively multimodal (image input) and always-on thinking (off unsupported).
          // Zero cost: served via the GLM Coding Plan endpoint like the other zai models.
          "id": "glm-5.3-flash",
          "name": "GLM-5.3 Flash",
          "api": "openai-completions",
          "provider": "zai",
          "baseUrl": "https://api.z.ai/api/coding/paas/v4",
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": true,
            "maxTokensField": "max_tokens",
            "thinkingFormat": "zai",
            "zaiToolStream": true
          },
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          },
          "input": ["text", "image"],
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "contextWindow": 1000000,
          "maxTokens": 131072
        }
      ]
    }
  }
}
