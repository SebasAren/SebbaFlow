#!/usr/bin/env bun
/**
 * tdd-plan — TDD plan management CLI
 *
 * Manages structured TDD implementation plans with RED/GREEN/REFACTOR progress
 * tracking. Plans are stored as JSON files in .pi/plans/.
 *
 * Usage:
 *   tdd-plan create <slug> --title "..." --steps '<json>'
 *   tdd-plan list
 *   tdd-plan show [slug]
 *   tdd-plan phase <slug> <step> <red|green|refactor> <start|done|skip> [--no-verify]
 *   tdd-plan complete <slug> <step>
 *   tdd-plan note <slug> <text>
 *   tdd-plan archive <slug>
 */

import {
	cmdArchive,
	cmdComplete,
	cmdCreate,
	cmdDesign,
	cmdEdit,
	cmdList,
	cmdNote,
	cmdPhase,
	cmdShow,
} from "./lib/commands";
import { PlanError } from "./lib/plan-io";

function printHelp(): void {
	console.log(`tdd-plan — TDD plan management CLI

Usage:
  tdd-plan create <slug> --title <title> (--steps <json> | --steps-file <path>) [--context <text>] [--architecture <text>] [--notes <json>]
  tdd-plan edit <slug> [--title <title>] [--steps <text> | --steps-file <path>] [--context <text>] [--architecture <text>] [--notes <json>]
  tdd-plan design <slug> [--show] [--current-state <text>] [--desired-state <text>] [--patterns <text>] [--decisions <text>] [--questions <text>]
  tdd-plan list
  tdd-plan show [slug]
  tdd-plan phase <slug> <step> <red|green|refactor> <start|done|skip> [--no-verify]
  tdd-plan complete <slug> <step>
  tdd-plan note <slug> <text>
  tdd-plan archive <slug>

Steps JSON format:
  [{"name":"Step 1: ...","red":"Establish failing condition (test, typecheck, compilation)...","green":"Implement...","refactor":"Clean up..."}]

Alternative: --steps-file for better multi-line support:
  tdd-plan create my-plan --title "My Plan" --steps-file steps.json

Plans are stored in .pi/plans/<slug>.json

Verify gate:
  phase ... green done runs the commands in .pi/config.json {verify:[...]} before
  persisting. On failure the phase stays in_progress and the CLI exits non-zero.
  An absent .pi/config.json skips the gate with a warning (portable default).
  --no-verify bypasses the gate entirely.`);
}

function main(): void {
	const command = process.argv[2];
	const args = process.argv.slice(3);

	try {
		switch (command) {
			case "create":
				cmdCreate(args);
				break;
			case "list":
				cmdList();
				break;
			case "show":
				cmdShow(args);
				break;
			case "phase":
				cmdPhase(args);
				break;
			case "complete":
				cmdComplete(args);
				break;
			case "note":
				cmdNote(args);
				break;
			case "archive":
				cmdArchive(args);
				break;
			case "design":
				cmdDesign(args);
				break;
			case "edit":
				cmdEdit(args);
				break;
			case undefined:
			case "help":
			case "--help":
			case "-h":
				printHelp();
				break;
			default:
				console.error(`Unknown command: ${command}`);
				console.error("Run 'tdd-plan help' for usage.");
				process.exit(1);
		}
	} catch (e) {
		if (e instanceof PlanError) {
			console.error(e.message);
			process.exit(1);
		}
		throw e;
	}
}

main();
