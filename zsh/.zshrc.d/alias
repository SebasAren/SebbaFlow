#!/bin/zsh
alias vi=nvim
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# Homebrew package tracking (brew-sync is stowed to ~/.local/bin/)
alias brewfile="nvim ~/dotfiles/homebrew/Brewfile"
alias superclaude="claude --dangerously-skip-permissions --agent supervisor"
alias dangerclaude="claude --dangerously-skip-permissions"
